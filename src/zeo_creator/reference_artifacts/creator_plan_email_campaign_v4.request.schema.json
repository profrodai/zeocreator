{
  "$defs": {
    "AudienceIntent": {
      "additionalProperties": false,
      "properties": {
        "consent_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_publication_use_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "frequency_cap_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "jurisdiction_policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "title": "Jurisdiction Policies",
          "type": "array"
        },
        "lifecycle_states": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Lifecycle States",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose_of_contact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Purpose Of Contact",
          "type": "string"
        },
        "required_exclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Exclusions",
          "type": "array"
        },
        "required_inclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Inclusions",
          "type": "array"
        },
        "segment_refs": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Refs",
          "type": "array"
        },
        "suppression_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "segment_refs",
        "consent_policy",
        "suppression_policy",
        "frequency_cap_policy",
        "purpose_of_contact",
        "cross_publication_use_policy"
      ],
      "title": "AudienceIntent",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailCTA": {
      "additionalProperties": false,
      "properties": {
        "cta_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Cta Id",
          "type": "string"
        },
        "desired_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Desired Action",
          "type": "string"
        },
        "label": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "link_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Link Id",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "cta_id",
        "link_id",
        "label",
        "desired_action"
      ],
      "title": "EmailCTA",
      "type": "object"
    },
    "EmailCampaignBrief": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "attribution_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "audience": {
          "$ref": "#/$defs/AudienceIntent"
        },
        "calls_to_action": {
          "items": {
            "$ref": "#/$defs/EmailCTA"
          },
          "minItems": 1,
          "title": "Calls To Action",
          "type": "array"
        },
        "campaign_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Campaign Id",
          "type": "string"
        },
        "conversion_objectives": {
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "minItems": 1,
          "title": "Conversion Objectives",
          "type": "array"
        },
        "objective": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "risks": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "stopping_conditions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stopping Conditions",
          "type": "array"
        },
        "tracking_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "window": {
          "$ref": "#/$defs/ResearchWindow"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "campaign_id",
        "objective",
        "audience",
        "window",
        "calls_to_action",
        "conversion_objectives",
        "attribution_policy",
        "tracking_policy",
        "stopping_conditions"
      ],
      "title": "EmailCampaignBrief",
      "type": "object"
    },
    "PublicationProfile": {
      "additionalProperties": false,
      "properties": {
        "approval_policy_ref": {
          "minLength": 1,
          "title": "Approval Policy Ref",
          "type": "string"
        },
        "audience_definition": {
          "minLength": 1,
          "title": "Audience Definition",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "cta_policy": {
          "minLength": 1,
          "title": "Cta Policy",
          "type": "string"
        },
        "default_channels": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Default Channels",
          "type": "array"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "editorial_pillars": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Editorial Pillars",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "participant_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Participant Refs",
          "type": "array"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "prohibited_claims": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Claims",
          "type": "array"
        },
        "prohibited_topics": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prohibited Topics",
          "type": "array"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "style_ref": {
          "minLength": 1,
          "title": "Style Ref",
          "type": "string"
        },
        "voice_rules": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Voice Rules",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "profile_id",
        "display_name",
        "audience_definition",
        "editorial_pillars",
        "voice_rules",
        "style_ref",
        "default_channels",
        "cta_policy",
        "approval_policy_ref"
      ],
      "title": "PublicationProfile",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "brief": {
      "$ref": "#/$defs/EmailCampaignBrief"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "publication": {
      "$ref": "#/$defs/PublicationProfile"
    }
  },
  "required": [
    "publication",
    "brief",
    "created_at"
  ],
  "title": "PlanEmailCampaignRequest",
  "type": "object"
}
