{
  "$defs": {
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailSequencePlan": {
      "additionalProperties": false,
      "properties": {
        "activation_requirements": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Activation Requirements",
          "type": "array"
        },
        "approval_requirements": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Approval Requirements",
          "type": "array"
        },
        "artifact_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "campaign_or_lifecycle_program": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "conversion_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entry_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "existing_enrollee_migration_policy": {
          "enum": [
            "retain_existing_revision",
            "explicit_new_authority"
          ],
          "title": "Existing Enrollee Migration Policy",
          "type": "string"
        },
        "exit_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "maximum_enrolment_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "migration_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "previous_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "quiet_hours_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "required_provider_semantics": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Provider Semantics",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "2.0.0",
          "default": "2.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "send_window_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/EmailSequenceStepPlan"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Steps",
          "type": "array"
        },
        "suppression_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "time_zone_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "campaign_or_lifecycle_program",
        "entry_policy",
        "exit_policy",
        "conversion_policy",
        "suppression_policy",
        "steps",
        "send_window_policy",
        "quiet_hours_policy",
        "time_zone_policy",
        "maximum_enrolment_window",
        "required_provider_semantics",
        "existing_enrollee_migration_policy",
        "activation_requirements",
        "approval_requirements",
        "generation"
      ],
      "title": "EmailSequencePlan",
      "type": "object"
    },
    "EmailSequenceStepPlan": {
      "additionalProperties": false,
      "properties": {
        "delay_anchor": {
          "const": "preceding_admitted_event",
          "default": "preceding_admitted_event",
          "title": "Delay Anchor",
          "type": "string"
        },
        "delay_seconds": {
          "maximum": 31536000,
          "minimum": 0,
          "title": "Delay Seconds",
          "type": "integer"
        },
        "desired_audience_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Desired Audience Action",
          "type": "string"
        },
        "exit_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "freshness_max_age_seconds": {
          "minimum": 1,
          "title": "Freshness Max Age Seconds",
          "type": "integer"
        },
        "message_plan": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "ordinal": {
          "maximum": 100,
          "minimum": 1,
          "title": "Ordinal",
          "type": "integer"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "required_approval_class": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Required Approval Class",
          "type": "string"
        },
        "send_window_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "skip_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "step_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Step Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "step_id",
        "ordinal",
        "message_plan",
        "delay_seconds",
        "purpose",
        "desired_audience_action",
        "send_window_policy",
        "skip_policy",
        "exit_policy",
        "freshness_max_age_seconds",
        "required_approval_class"
      ],
      "title": "EmailSequenceStepPlan",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sequence": {
      "$ref": "#/$defs/EmailSequencePlan"
    }
  },
  "required": [
    "sequence"
  ],
  "title": "PlanEmailSequenceResponse",
  "type": "object"
}
