      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "publication_profile",
        "business_objective",
        "audience",
        "campaign_window",
        "calls_to_action",
        "conversion_objectives",
        "attribution_policy",
        "tracking_policy",
        "required_human_approvals",
        "stopping_conditions",
        "generation"
      ],
