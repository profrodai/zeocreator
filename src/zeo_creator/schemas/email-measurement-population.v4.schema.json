          "title": "Schema Version",
          "type": "string"
        },
        "stopping_conditions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stopping Conditions",
          "type": "array"
        },
        "tracking_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        }
