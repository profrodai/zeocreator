        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
