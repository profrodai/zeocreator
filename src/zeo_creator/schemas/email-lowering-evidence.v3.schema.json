{
  "$defs": {
    "CapabilityId": {
      "additionalProperties": false,
      "description": "Immutable capability identity. Mutation after construction is forbidden.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "title": "CapabilityId",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Account Ref",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "connector_revision": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connector Revision",
          "type": "string"
        },
        "lowering_profile": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "provider_kind",
        "connection_ref",
        "account_ref",
        "connector_revision",
        "lowering_profile"
      ],
      "title": "EmailExecutionContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "covered_snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Covered Snapshot Digest",
      "type": "string"
    },
    "covered_tokens": {
      "default": [],
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
        "type": "string"
      },
      "title": "Covered Tokens",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "execution": {
      "$ref": "#/$defs/EmailExecutionContext"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "issuer": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "missing_value_behavior": {
      "const": "refuse",
      "default": "refuse",
      "title": "Missing Value Behavior",
      "type": "string"
    },
    "observed_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Observed Payload Digest",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "verified",
        "needs_review",
        "ambiguous"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "receipt": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "receipt_contract": {
      "$ref": "#/$defs/CapabilityId"
    },
    "receipt_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Contract Digest",
      "type": "string"
    },
    "rendered_preview_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Preview Digest",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "3.0.0",
      "default": "3.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sender_identity": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "submitted_payload_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Submitted Payload Digest",
      "type": "string"
    },
    "template_mapping_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Template Mapping Digest",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "artifact_id",
    "receipt",
    "issuer",
    "receipt_contract",
    "receipt_contract_digest",
    "execution",
    "draft",
    "sender_identity",
    "template_mapping_digest",
    "submitted_payload_digest",
    "observed_payload_digest",
    "rendered_preview_digest",
    "covered_snapshot_digest",
    "outcome"
  ],
  "title": "EmailLoweringEvidence",
  "type": "object"
}
