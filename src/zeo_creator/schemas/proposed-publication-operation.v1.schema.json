{
  "$defs": {
    "ChannelDestination": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "connection_ref": {
          "minLength": 1,
          "title": "Connection Ref",
          "type": "string"
        },
        "destination_account_ref": {
          "minLength": 1,
          "title": "Destination Account Ref",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Provider Kind",
          "type": "string"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        }
      },
      "required": [
        "channel",
        "provider_kind",
        "connection_ref",
        "destination_account_ref"
      ],
      "title": "ChannelDestination",
      "type": "object"
    },
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    },
    "EffectKind": {
      "description": "Declared side-effect kind. Declarations are not permission grants.",
      "enum": [
        "read",
        "write",
        "delete",
        "external_communication",
        "financial",
        "security_sensitive"
      ],
      "title": "EffectKind",
      "type": "string"
    },
    "ExtensionPayload": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "schema_id",
        "schema_version",
        "schema_digest",
        "payload"
      ],
      "title": "ExtensionPayload",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "accessibility_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessibility Text"
    },
    "approval_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "artifact_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Manifest Digest",
      "type": "string"
    },
    "artifact_manifest_ref": {
      "minLength": 1,
      "title": "Artifact Manifest Ref",
      "type": "string"
    },
    "channel": {
      "minLength": 1,
      "title": "Channel",
      "type": "string"
    },
    "content": {
      "$ref": "#/$defs/ContentDocument"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "destination": {
      "$ref": "#/$defs/ChannelDestination"
    },
    "extension": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "idempotency_key": {
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "required_effects": {
      "default": [
        "write",
        "external_communication"
      ],
      "items": {
        "$ref": "#/$defs/EffectKind"
      },
      "title": "Required Effects",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "scheduled_for": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scheduled For"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_artifact_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Artifact Refs",
      "type": "array"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "operation_id",
    "artifact_manifest_ref",
    "artifact_manifest_digest",
    "channel",
    "destination",
    "selected_artifact_refs",
    "content",
    "approval_digest",
    "idempotency_key"
  ],
  "title": "ProposedPublicationOperation",
  "type": "object"
}
