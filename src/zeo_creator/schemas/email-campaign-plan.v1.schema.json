{
  "$defs": {
    "AudienceIntent": {
      "additionalProperties": false,
      "properties": {
        "consent_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_publication_use_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "frequency_cap_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "jurisdiction_policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "title": "Jurisdiction Policies",
          "type": "array"
        },
        "lifecycle_states": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Lifecycle States",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose_of_contact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Purpose Of Contact",
          "type": "string"
        },
        "required_exclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Exclusions",
          "type": "array"
        },
        "required_inclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Inclusions",
          "type": "array"
        },
        "segment_refs": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Refs",
          "type": "array"
        },
        "suppression_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "segment_refs",
        "consent_policy",
        "suppression_policy",
        "frequency_cap_policy",
        "purpose_of_contact",
        "cross_publication_use_policy"
      ],
      "title": "AudienceIntent",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailCTA": {
      "additionalProperties": false,
      "properties": {
        "cta_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Cta Id",
          "type": "string"
        },
        "desired_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Desired Action",
          "type": "string"
        },
        "label": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "link_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Link Id",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "cta_id",
        "link_id",
        "label",
        "desired_action"
      ],
      "title": "EmailCTA",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "assumptions": {
      "default": [],
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Assumptions",
      "type": "array"
    },
    "attribution_policy": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "audience": {
      "$ref": "#/$defs/AudienceIntent"
    },
    "business_objective": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Business Objective",
      "type": "string"
    },
    "calls_to_action": {
      "items": {
        "$ref": "#/$defs/EmailCTA"
      },
      "minItems": 1,
      "title": "Calls To Action",
      "type": "array"
    },
    "campaign_window": {
      "$ref": "#/$defs/ResearchWindow"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "conversion_objectives": {
      "items": {
        "$ref": "#/$defs/EmailArtifactRef"
      },
      "minItems": 1,
      "title": "Conversion Objectives",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generation": {
      "$ref": "#/$defs/GenerationTrace"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "message_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EmailArtifactRef"
      },
      "title": "Message Refs",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "publication_profile": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "required_human_approvals": {
      "items": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Required Human Approvals",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "risks": {
      "default": [],
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EmailArtifactRef"
      },
      "title": "Sequence Refs",
      "type": "array"
    },
    "stopping_conditions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Stopping Conditions",
      "type": "array"
    },
    "tracking_policy": {
      "$ref": "#/$defs/EmailArtifactRef"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "artifact_id",
    "publication_profile",
    "business_objective",
    "audience",
    "campaign_window",
    "calls_to_action",
    "conversion_objectives",
    "attribution_policy",
    "tracking_policy",
    "required_human_approvals",
    "stopping_conditions",
    "generation"
  ],
  "title": "EmailCampaignPlan",
  "type": "object"
}
