{
  "$defs": {
    "AudienceSnapshotSummary": {
      "additionalProperties": false,
      "properties": {
        "audience_intent_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Audience Intent Digest",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "consent_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Consent Policy Digest",
          "type": "string"
        },
        "drift_status": {
          "enum": [
            "unchanged",
            "changed",
            "unknown"
          ],
          "title": "Drift Status",
          "type": "string"
        },
        "eligible_count": {
          "minimum": 0,
          "title": "Eligible Count",
          "type": "integer"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "production",
            "test"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        },
        "segment_definition_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Segment Definition Digest",
          "type": "string"
        },
        "snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Snapshot Digest",
          "type": "string"
        },
        "snapshot_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Snapshot Ref",
          "type": "string"
        },
        "suppressed_count": {
          "minimum": 0,
          "title": "Suppressed Count",
          "type": "integer"
        },
        "suppression_policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Suppression Policy Digest",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "snapshot_ref",
        "snapshot_digest",
        "provider_kind",
        "connection_ref",
        "audience_intent_digest",
        "eligible_count",
        "suppressed_count",
        "resolved_at",
        "expires_at",
        "segment_definition_digest",
        "consent_policy_digest",
        "suppression_policy_digest",
        "drift_status",
        "purpose"
      ],
      "title": "AudienceSnapshotSummary",
      "type": "object"
    },
    "CapabilityId": {
      "additionalProperties": false,
      "description": "Immutable capability identity. Mutation after construction is forbidden.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "title": "CapabilityId",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Account Ref",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "connector_revision": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connector Revision",
          "type": "string"
        },
        "lowering_profile": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "provider_kind",
        "connection_ref",
        "account_ref",
        "connector_revision",
        "lowering_profile"
      ],
      "title": "EmailExecutionContext",
      "type": "object"
    },
    "EmailMigrationStep": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "enum": [
            "retain",
            "skip",
            "restart"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "source_step": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Source Step",
          "type": "string"
        },
        "target_step": {
          "anyOf": [
            {
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Target Step"
        }
      },
      "required": [
        "source_step",
        "target_step",
        "disposition"
      ],
      "title": "EmailMigrationStep",
      "type": "object"
    },
    "EmailRemoteReceipt": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "campaign_release": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivery": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "execution": {
          "$ref": "#/$defs/EmailExecutionContext"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "issuer": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "kind": {
          "enum": [
            "draft",
            "scheduled_broadcast",
            "sequence_revision",
            "broadcast"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message_plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "operation": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "confirmed",
            "needs_review",
            "ambiguous"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "receipt_contract": {
          "$ref": "#/$defs/CapabilityId"
        },
        "receipt_contract_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Receipt Contract Digest",
          "type": "string"
        },
        "remote_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Remote Ref",
          "type": "string"
        },
        "remote_revision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Remote Revision Digest",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "3.0.0",
          "default": "3.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "operation",
        "campaign_release",
        "execution",
        "issuer",
        "receipt_contract",
        "receipt_contract_digest",
        "remote_ref",
        "remote_revision_digest",
        "kind",
        "outcome"
      ],
      "title": "EmailRemoteReceipt",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "enrollees": {
      "$ref": "#/$defs/AudienceSnapshotSummary"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "source_sequence": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/EmailMigrationStep"
      },
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "target_receipt": {
      "$ref": "#/$defs/EmailRemoteReceipt"
    },
    "target_sequence": {
      "$ref": "#/$defs/EmailArtifactRef"
    }
  },
  "required": [
    "organization_id",
    "publication_id",
    "target_receipt",
    "source_sequence",
    "target_sequence",
    "enrollees",
    "policy",
    "steps"
  ],
  "title": "EmailMigrationPlan",
  "type": "object"
}
