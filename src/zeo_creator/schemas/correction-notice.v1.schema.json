{
  "$defs": {
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "corrected_claim_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Corrected Claim Refs",
      "type": "array"
    },
    "correction_id": {
      "minLength": 1,
      "title": "Correction Id",
      "type": "string"
    },
    "correction_text": {
      "$ref": "#/$defs/ContentDocument"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "editor_review_ref": {
      "minLength": 1,
      "title": "Editor Review Ref",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "publication_artifact_ref": {
      "minLength": 1,
      "title": "Publication Artifact Ref",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "correction_id",
    "publication_artifact_ref",
    "corrected_claim_refs",
    "correction_text",
    "reason",
    "effective_at",
    "editor_review_ref"
  ],
  "title": "CorrectionNotice",
  "type": "object"
}
