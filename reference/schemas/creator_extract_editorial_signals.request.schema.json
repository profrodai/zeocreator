        "author_or_origin": {
          "minLength": 1,
          "title": "Author Or Origin",
          "type": "string"
        },
        "availability": {
          "minLength": 1,
          "title": "Availability",
          "type": "string"
        },
        "canonical_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
