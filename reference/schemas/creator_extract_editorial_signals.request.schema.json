        "created_at",
        "organization_id",
        "publication_id",
        "observation_id",
        "source_identity",
        "source_kind",
        "retrieved_at",
        "author_or_origin",
        "publication_scope",
        "raw_artifact_ref",
        "raw_artifact_digest",
        "extracted_content_ref",
        "extracted_content_digest",
        "completeness",
        "availability",
        "language",
        "extraction_method",
        "extraction_version",
        "access_policy_ref",
        "retention_policy_ref"
