          "minLength": 1,
          "title": "Extracted Content Ref",
          "type": "string"
        },
        "extracted_text": {
          "default": "",
          "title": "Extracted Text",
          "type": "string"
        },
        "extraction_method": {
          "minLength": 1,
          "title": "Extraction Method",
          "type": "string"
        },
        "extraction_version": {
          "minLength": 1,
          "title": "Extraction Version",
          "type": "string"
        },
        "geography": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Geography",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
