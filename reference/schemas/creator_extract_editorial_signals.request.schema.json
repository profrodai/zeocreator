      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    }
  },
  "required": [
    "organization_id",
    "publication_id",
    "observations",
    "created_at"
  ],
  "title": "ExtractEditorialSignalsRequest",
  "type": "object"
}
