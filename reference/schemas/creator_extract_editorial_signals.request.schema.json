{
  "$defs": {
    "ObservationCompleteness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "ObservationCompleteness",
      "type": "string"
    },
    "SourceObservation": {
      "additionalProperties": false,
