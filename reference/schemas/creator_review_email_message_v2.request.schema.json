        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose_of_contact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Purpose Of Contact",
          "type": "string"
        },
        "required_exclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Exclusions",
          "type": "array"
        },
        "required_inclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Inclusions",
          "type": "array"
