{
  "$defs": {
    "ArtifactDigestProof": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "pattern": "^sha256$",
          "title": "Algorithm",
          "type": "string"
        },
        "byte_length": {
          "exclusiveMinimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        },
        "tool_identity": {
          "minLength": 1,
          "title": "Tool Identity",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "algorithm",
        "digest",
        "byte_length",
        "storage_ref",
        "retrieved_at",
        "evidence_ref",
        "tool_identity",
        "tool_version"
      ],
      "title": "ArtifactDigestProof",
      "type": "object"
    },
    "RenderAttestation": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "check_version": {
          "minLength": 1,
          "title": "Check Version",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expected_constraint": {
          "minLength": 1,
          "title": "Expected Constraint",
          "type": "string"
        },
        "observed_value": {
          "minLength": 1,
          "title": "Observed Value",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "boolean"
        },
        "tool_identity": {
          "minLength": 1,
          "title": "Tool Identity",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "check_version",
        "result",
        "evidence_ref",
        "tool_identity",
        "observed_value",
        "expected_constraint"
      ],
      "title": "RenderAttestation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Artifact Digest",
      "type": "string"
    },
    "artifact_digest_proof": {
      "$ref": "#/$defs/ArtifactDigestProof"
    },
    "artifact_ref": {
      "minLength": 1,
      "title": "Artifact Ref",
      "type": "string"
    },
    "attestations": {
      "items": {
        "$ref": "#/$defs/RenderAttestation"
      },
      "minItems": 1,
      "title": "Attestations",
      "type": "array"
    },
    "brand_profile_ref": {
      "minLength": 1,
      "title": "Brand Profile Ref",
      "type": "string"
    },
    "brief_content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Brief Content Digest",
      "type": "string"
    },
    "brief_id": {
      "minLength": 1,
      "title": "Brief Id",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "content_revision": {
      "minimum": 1,
      "title": "Content Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "rendered_claim_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rendered Claim Ids",
      "type": "array"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "manifest_id",
    "brief_id",
    "content_revision",
    "brief_content_digest",
    "artifact_ref",
    "artifact_digest",
    "brand_profile_ref",
    "artifact_digest_proof",
    "attestations"
  ],
  "title": "RenderManifest",
  "type": "object"
}
