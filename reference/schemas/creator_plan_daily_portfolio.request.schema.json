{
  "$defs": {
    "ContentHistoryEntry": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deliverable_kind": {
          "$ref": "#/$defs/DeliverableKind"
        },
        "history_id": {
          "minLength": 1,
          "title": "History Id",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "published_at": {
          "format": "date-time",
          "title": "Published At",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "topic": {
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "history_id",
        "deliverable_kind",
        "topic",
        "published_at",
        "artifact_ref"
      ],
      "title": "ContentHistoryEntry",
      "type": "object"
    },
    "DeliverableKind": {
      "enum": [
        "animated_episode",
        "hud",
        "comic_slides"
      ],
      "title": "DeliverableKind",
      "type": "string"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_refs"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "PortfolioConstraints": {
      "additionalProperties": false,
      "properties": {
        "assignments_per_publication": {
          "default": 3,
          "minimum": 1,
          "title": "Assignments Per Publication",
          "type": "integer"
        },
        "avoid_recent_topics": {
          "default": true,
          "title": "Avoid Recent Topics",
          "type": "boolean"
        },
        "required_kinds": {
          "default": [
            "animated_episode",
            "hud",
            "comic_slides"
          ],
          "items": {
            "$ref": "#/$defs/DeliverableKind"
          },
          "title": "Required Kinds",
          "type": "array"
        }
      },
      "title": "PortfolioConstraints",
      "type": "object"
    },
    "PublicationObjective": {
      "additionalProperties": false,
      "properties": {
        "desired_audience_action": {
          "minLength": 1,
          "title": "Desired Audience Action",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        }
      },
      "required": [
        "publication_id",
        "objective",
        "desired_audience_action"
      ],
      "title": "PublicationObjective",
      "type": "object"
    },
    "PublicationProfile": {
      "additionalProperties": false,
