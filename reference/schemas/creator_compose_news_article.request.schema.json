          "default": null,
          "title": "Disclosure"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "contributor_ref",
        "role"
      ],
      "title": "BylineAssignment",
      "type": "object"
    },
    "EvidenceClaim": {
