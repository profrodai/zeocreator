{
  "$defs": {
    "CapabilityId": {
      "additionalProperties": false,
      "description": "Immutable capability identity. Mutation after construction is forbidden.",
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "name",
        "version"
      ],
      "title": "CapabilityId",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailExecutionContext": {
      "additionalProperties": false,
      "properties": {
        "account_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Account Ref",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "connector_revision": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connector Revision",
          "type": "string"
        },
        "lowering_profile": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "provider_kind",
        "connection_ref",
        "account_ref",
        "connector_revision",
        "lowering_profile"
      ],
      "title": "EmailExecutionContext",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "campaign_release": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/EmailExecutionContext"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "issuer": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "kind": {
      "enum": [
        "draft",
        "scheduled_broadcast",
        "sequence_revision",
        "broadcast"
      ],
      "title": "Kind",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "confirmed",
        "needs_review",
        "ambiguous"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "receipt_contract": {
      "$ref": "#/$defs/CapabilityId"
    },
    "receipt_contract_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Receipt Contract Digest",
      "type": "string"
    },
    "remote_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Remote Ref",
      "type": "string"
    },
    "remote_revision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Remote Revision Digest",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "anyOf": [
        {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "artifact_id",
    "operation",
    "campaign_release",
    "execution",
    "issuer",
    "receipt_contract",
    "receipt_contract_digest",
    "remote_ref",
    "remote_revision_digest",
    "kind",
    "outcome"
  ],
  "title": "EmailRemoteReceipt",
  "type": "object"
}
