{
  "$defs": {
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Caller-supplied review evidence; authenticity is verified by the controlling runtime.",
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "check": {
      "enum": [
        "source_traceability",
        "publication_voice",
        "audience_policy",
        "subject_body",
        "html_plain_text",
        "links",
        "cta",
        "personalization",
        "accessibility",
        "footer_unsubscribe",
        "consent_suppression",
        "claims",
        "preview",
        "test_send"
      ],
      "title": "Check",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "draft": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "policy": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "receipt_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Receipt Ref",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "valid_until": {
      "format": "date-time",
      "title": "Valid Until",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "artifact_id",
    "draft",
    "check",
    "passed",
    "policy",
    "receipt_ref",
    "valid_until"
  ],
  "title": "EmailReviewEvidence",
  "type": "object"
}
