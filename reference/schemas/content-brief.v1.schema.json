{
  "$defs": {
    "AttestationPolicy": {
      "enum": [
        "required",
        "advisory"
      ],
      "title": "AttestationPolicy",
      "type": "string"
    },
    "AttestationRequirement": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "check_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Check Version"
        },
        "policy": {
          "$ref": "#/$defs/AttestationPolicy"
        }
      },
      "required": [
        "check_id",
        "policy"
      ],
      "title": "AttestationRequirement",
      "type": "object"
    },
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_refs"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "ExtensionPayload": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "schema_id",
        "schema_version",
        "schema_digest",
        "payload"
      ],
      "title": "ExtensionPayload",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "minLength": 1,
      "title": "Assignment Id",
      "type": "string"
    },
    "audience": {
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "brand_profile_ref": {
      "minLength": 1,
      "title": "Brand Profile Ref",
      "type": "string"
    },
    "brief_id": {
      "minLength": 1,
      "title": "Brief Id",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "content_kind": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "title": "Content Kind",
      "type": "string"
    },
    "content_revision": {
      "default": 1,
      "minimum": 1,
      "title": "Content Revision",
      "type": "integer"
    },
    "core_message": {
      "minLength": 1,
      "title": "Core Message",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "creative_direction": {
      "minLength": 1,
      "title": "Creative Direction",
      "type": "string"
    },
    "delivery_requirements": {
      "items": {
        "$ref": "#/$defs/AttestationRequirement"
      },
      "minItems": 1,
      "title": "Delivery Requirements",
      "type": "array"
    },
    "desired_audience_action": {
      "minLength": 1,
      "title": "Desired Audience Action",
      "type": "string"
    },
    "evidence_claims": {
      "items": {
        "$ref": "#/$defs/EvidenceClaim"
      },
      "minItems": 1,
      "title": "Evidence Claims",
      "type": "array"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "participant_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Participant Refs",
      "type": "array"
    },
    "producer_extension": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prohibited_claims": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Prohibited Claims",
      "type": "array"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "slug_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Slug Hint"
    },
    "source_content": {
      "$ref": "#/$defs/ContentDocument"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Refs",
      "type": "array"
    },
    "style_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Style Ref"
    },
    "target_channels": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Target Channels",
      "type": "array"
    },
    "working_title": {
      "minLength": 1,
      "title": "Working Title",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "brief_id",
    "assignment_id",
    "content_kind",
    "working_title",
    "objective",
    "audience",
    "desired_audience_action",
    "core_message",
    "creative_direction",
    "source_content",
    "evidence_claims",
    "source_refs",
    "brand_profile_ref",
    "target_channels",
    "delivery_requirements"
  ],
  "title": "ContentBrief",
  "type": "object"
}
