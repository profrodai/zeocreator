{
  "additionalProperties": false,
  "properties": {
    "audience_intent_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Audience Intent Digest",
      "type": "string"
    },
    "connection_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Connection Ref",
      "type": "string"
    },
    "consent_policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Consent Policy Digest",
      "type": "string"
    },
    "drift_status": {
      "enum": [
        "unchanged",
        "changed",
        "unknown"
      ],
      "title": "Drift Status",
      "type": "string"
    },
    "eligible_count": {
      "minimum": 0,
      "title": "Eligible Count",
      "type": "integer"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "provider_kind": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Provider Kind",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "production",
        "test"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "resolved_at": {
      "format": "date-time",
      "title": "Resolved At",
      "type": "string"
    },
    "segment_definition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Segment Definition Digest",
      "type": "string"
    },
    "snapshot_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Snapshot Digest",
      "type": "string"
    },
    "snapshot_ref": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Snapshot Ref",
      "type": "string"
    },
    "suppressed_count": {
      "minimum": 0,
      "title": "Suppressed Count",
      "type": "integer"
    },
    "suppression_policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suppression Policy Digest",
      "type": "string"
    }
  },
  "required": [
    "organization_id",
    "publication_id",
    "snapshot_ref",
    "snapshot_digest",
    "provider_kind",
    "connection_ref",
    "audience_intent_digest",
    "eligible_count",
    "suppressed_count",
    "resolved_at",
    "expires_at",
    "segment_definition_digest",
    "consent_policy_digest",
    "suppression_policy_digest",
    "drift_status",
    "purpose"
  ],
  "title": "AudienceSnapshotSummary",
  "type": "object"
}
