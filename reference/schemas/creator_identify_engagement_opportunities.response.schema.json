{
  "$defs": {
    "EngagementDisposition": {
      "enum": [
        "IGNORE",
        "MONITOR",
        "LIKE",
        "REPOST",
        "QUOTE",
        "REPLY",
        "ORIGINAL_POST",
        "ESCALATE"
      ],
      "title": "EngagementDisposition",
      "type": "string"
    },
    "EngagementOpportunity": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "conversation_ref": {
          "minLength": 1,
          "title": "Conversation Ref",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/EngagementDisposition"
        },
        "distinctive_contribution": {
          "minLength": 1,
          "title": "Distinctive Contribution",
          "type": "string"
        },
        "evidence_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "expected_community_value": {
          "minLength": 1,
          "title": "Expected Community Value",
          "type": "string"
        },
        "expertise_basis_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expertise Basis Ref"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "opportunity_id": {
          "minLength": 1,
          "title": "Opportunity Id",
          "type": "string"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "participant_relationship_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Participant Relationship Ref"
        },
        "persona_ref": {
          "minLength": 1,
          "title": "Persona Ref",
          "type": "string"
        },
        "proposed_stance": {
          "minLength": 1,
          "title": "Proposed Stance",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeliness_expires_at": {
          "format": "date-time",
          "title": "Timeliness Expires At",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "opportunity_id",
        "conversation_ref",
        "disposition",
        "persona_ref",
        "distinctive_contribution",
        "proposed_stance",
        "risk_level",
        "timeliness_expires_at",
        "expected_community_value",
        "generation"
      ],
      "title": "EngagementOpportunity",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "opportunity": {
      "$ref": "#/$defs/EngagementOpportunity"
    }
  },
  "required": [
    "opportunity"
  ],
  "title": "IdentifyEngagementOpportunitiesResponse",
  "type": "object"
}
