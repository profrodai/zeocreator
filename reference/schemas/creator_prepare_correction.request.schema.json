{
  "$defs": {
    "BylineAssignment": {
      "additionalProperties": false,
      "properties": {
        "accepted": {
          "default": false,
          "title": "Accepted",
          "type": "boolean"
        },
        "contributor_ref": {
          "minLength": 1,
          "title": "Contributor Ref",
          "type": "string"
        },
        "disclosure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disclosure"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "contributor_ref",
        "role"
      ],
      "title": "BylineAssignment",
      "type": "object"
    },
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    },
    "EditorialReview": {
      "additionalProperties": false,
      "properties": {
        "advisory_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Advisory Findings",
          "type": "array"
        },
        "approval_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approval Digest",
          "type": "string"
        },
        "article_draft_ref": {
          "minLength": 1,
          "title": "Article Draft Ref",
          "type": "string"
        },
        "attribution_satisfied": {
          "title": "Attribution Satisfied",
          "type": "boolean"
        },
        "blocking_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocking Findings",
          "type": "array"
        },
        "claim_traceability": {
          "title": "Claim Traceability",
          "type": "boolean"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "privacy_satisfied": {
          "title": "Privacy Satisfied",
          "type": "boolean"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "qualified_human_required": {
          "title": "Qualified Human Required",
          "type": "boolean"
        },
        "qualified_human_review_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualified Human Review Ref"
        },
        "ready_for_approval": {
          "title": "Ready For Approval",
          "type": "boolean"
        },
        "review_id": {
          "minLength": 1,
          "title": "Review Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy_satisfied": {
          "title": "Risk Policy Satisfied",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "review_id",
        "article_draft_ref",
        "claim_traceability",
        "attribution_satisfied",
        "privacy_satisfied",
        "risk_policy_satisfied",
        "qualified_human_required",
        "ready_for_approval",
        "approval_digest",
        "generation"
      ],
      "title": "EditorialReview",
      "type": "object"
    },
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_refs"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "NewsArticleDraft": {
      "additionalProperties": false,
      "properties": {
        "article_draft_id": {
          "minLength": 1,
          "title": "Article Draft Id",
          "type": "string"
        },
        "article_plan_ref": {
          "minLength": 1,
          "title": "Article Plan Ref",
          "type": "string"
        },
        "body": {
          "$ref": "#/$defs/ContentDocument"
        },
        "bylines": {
          "items": {
            "$ref": "#/$defs/BylineAssignment"
          },
          "minItems": 1,
          "title": "Bylines",
          "type": "array"
        },
        "claims": {
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "minItems": 1,
          "title": "Claims",
          "type": "array"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deck": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deck"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "headline": {
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "article_draft_id",
        "article_plan_ref",
        "headline",
        "body",
        "claims",
        "source_refs",
        "bylines",
        "generation"
      ],
      "title": "NewsArticleDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "article": {
      "$ref": "#/$defs/NewsArticleDraft"
    },
    "corrected_claim_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Corrected Claim Refs",
      "type": "array"
    },
    "correction_text": {
      "$ref": "#/$defs/ContentDocument"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "effective_at": {
      "format": "date-time",
      "title": "Effective At",
      "type": "string"
    },
    "publication_artifact_ref": {
      "minLength": 1,
      "title": "Publication Artifact Ref",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "review": {
      "$ref": "#/$defs/EditorialReview"
    }
  },
  "required": [
    "article",
    "review",
    "publication_artifact_ref",
    "corrected_claim_refs",
    "correction_text",
    "reason",
    "effective_at",
    "created_at"
  ],
  "title": "PrepareCorrectionRequest",
  "type": "object"
}
