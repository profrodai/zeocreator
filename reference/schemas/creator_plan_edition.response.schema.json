{
  "$defs": {
    "EditionItem": {
      "additionalProperties": false,
      "properties": {
        "dossier_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dossier Refs",
          "type": "array"
        },
        "prominence": {
          "minimum": 1,
          "title": "Prominence",
          "type": "integer"
        },
        "required_content_kinds": {
          "items": {
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Content Kinds",
          "type": "array"
        },
        "slot_ref": {
          "minLength": 1,
          "title": "Slot Ref",
          "type": "string"
        }
      },
      "required": [
        "slot_ref",
        "prominence",
        "required_content_kinds"
      ],
      "title": "EditionItem",
      "type": "object"
    },
    "EditionPlan": {
      "additionalProperties": false,
      "properties": {
        "agenda_ref": {
          "minLength": 1,
          "title": "Agenda Ref",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "correction_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Correction Refs",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "edition_id": {
          "minLength": 1,
          "title": "Edition Id",
          "type": "string"
        },
        "edition_kind": {
          "minLength": 1,
          "title": "Edition Kind",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "human_editor_requirements": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Human Editor Requirements",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "lead_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EditionItem"
          },
          "title": "Lead Items",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "publication_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shared_relationship_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shared Relationship Ref"
        },
        "supporting_items": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EditionItem"
          },
          "title": "Supporting Items",
          "type": "array"
        },
        "update_policy_ref": {
          "minLength": 1,
          "title": "Update Policy Ref",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "edition_id",
        "agenda_ref",
        "edition_kind",
        "publication_window",
        "update_policy_ref",
        "generation"
      ],
      "title": "EditionPlan",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "edition": {
      "$ref": "#/$defs/EditionPlan"
    }
  },
  "required": [
    "edition"
  ],
  "title": "PlanEditionResponse",
  "type": "object"
}
