{
  "$defs": {
    "ChannelDestination": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "connection_ref": {
          "minLength": 1,
          "title": "Connection Ref",
          "type": "string"
        },
        "destination_account_ref": {
          "minLength": 1,
          "title": "Destination Account Ref",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Provider Kind",
          "type": "string"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        }
      },
      "required": [
        "channel",
        "provider_kind",
        "connection_ref",
        "destination_account_ref"
      ],
      "title": "ChannelDestination",
      "type": "object"
    },
    "DeliveryFinding": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "minLength": 1,
          "title": "Category",
          "type": "string"
        },
        "code": {
          "pattern": "^ZEO_CREATOR_[A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/FindingSeverity"
        }
      },
      "required": [
        "code",
        "severity",
        "category",
        "message"
      ],
      "title": "DeliveryFinding",
      "type": "object"
    },
    "FindingSeverity": {
      "enum": [
        "blocking",
        "advisory"
      ],
      "title": "FindingSeverity",
      "type": "string"
    },
    "PublicationPayload": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "minLength": 1,
          "title": "Alt Text",
          "type": "string"
        },
        "caption": {
          "minLength": 1,
          "title": "Caption",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "caption",
        "description",
        "alt_text"
      ],
      "title": "PublicationPayload",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "approval_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Approval Digest",
      "type": "string"
    },
    "artifact_integrity_pass": {
      "title": "Artifact Integrity Pass",
      "type": "boolean"
    },
    "artifact_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Artifact Refs",
      "type": "array"
    },
    "brand_constraints_pass": {
      "title": "Brand Constraints Pass",
      "type": "boolean"
    },
    "brief_id": {
      "minLength": 1,
      "title": "Brief Id",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "findings": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DeliveryFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "identity_match": {
      "title": "Identity Match",
      "type": "boolean"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "manifest_id": {
      "minLength": 1,
      "title": "Manifest Id",
      "type": "string"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "proposed_destinations": {
      "items": {
        "$ref": "#/$defs/ChannelDestination"
      },
      "title": "Proposed Destinations",
      "type": "array"
    },
    "proposed_payload": {
      "$ref": "#/$defs/PublicationPayload"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "ready_for_approval": {
      "title": "Ready For Approval",
      "type": "boolean"
    },
    "required_attestations_pass": {
      "title": "Required Attestations Pass",
      "type": "boolean"
    },
    "review_id": {
      "minLength": 1,
      "title": "Review Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_claim_traceability": {
      "title": "Source Claim Traceability",
      "type": "boolean"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "review_id",
    "brief_id",
    "manifest_id",
    "artifact_refs",
    "identity_match",
    "required_attestations_pass",
    "source_claim_traceability",
    "brand_constraints_pass",
    "artifact_integrity_pass",
    "proposed_payload",
    "proposed_destinations",
    "approval_digest",
    "ready_for_approval"
  ],
  "title": "DeliveryReviewBundle",
  "type": "object"
}
