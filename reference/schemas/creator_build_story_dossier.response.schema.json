{
  "$defs": {
    "EvidenceClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "evidence_refs"
      ],
      "title": "EvidenceClaim",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "RiskLevel": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "StoryDossier": {
      "additionalProperties": false,
      "properties": {
        "audience_significance": {
          "minLength": 1,
          "title": "Audience Significance",
          "type": "string"
        },
        "community_conversation_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Community Conversation Refs",
          "type": "array"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "contradictions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Contradictions",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "dossier_id": {
          "minLength": 1,
          "title": "Dossier Id",
          "type": "string"
        },
        "evidence_lineage": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Lineage",
          "type": "array"
        },
        "frozen_at": {
          "format": "date-time",
          "title": "Frozen At",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "possible_angles": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Possible Angles",
          "type": "array"
        },
        "prior_coverage_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Prior Coverage Refs",
          "type": "array"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "quotation_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Quotation Refs",
          "type": "array"
        },
        "recommended_framing": {
          "minLength": 1,
          "title": "Recommended Framing",
          "type": "string"
        },
        "rejected_framings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rejected Framings",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_level": {
          "$ref": "#/$defs/RiskLevel"
        },
        "risk_notes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Risk Notes",
          "type": "array"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "story_id": {
          "minLength": 1,
          "title": "Story Id",
          "type": "string"
        },
        "story_revision_ref": {
          "minLength": 1,
          "title": "Story Revision Ref",
          "type": "string"
        },
        "suggested_follow_up": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Suggested Follow Up",
          "type": "array"
        },
        "timeline": {
          "default": [],
          "items": {
            "$ref": "#/$defs/StoryTimelineEntry"
          },
          "title": "Timeline",
          "type": "array"
        },
        "unknowns": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unknowns",
          "type": "array"
        },
        "verified_claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceClaim"
          },
          "title": "Verified Claims",
          "type": "array"
        },
        "visual_opportunities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Visual Opportunities",
          "type": "array"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "dossier_id",
        "story_id",
        "story_revision_ref",
        "evidence_lineage",
        "audience_significance",
        "recommended_framing",
        "risk_level",
        "frozen_at",
        "generation"
      ],
      "title": "StoryDossier",
      "type": "object"
    },
    "StoryTimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "occurred_at",
        "summary",
        "source_refs"
      ],
      "title": "StoryTimelineEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "dossier": {
      "$ref": "#/$defs/StoryDossier"
    }
  },
  "required": [
    "dossier"
  ],
  "title": "BuildStoryDossierResponse",
  "type": "object"
}
