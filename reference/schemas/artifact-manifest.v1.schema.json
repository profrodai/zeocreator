          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Artifact Refs",
          "type": "array"
        },
        "check_id": {
          "minLength": 1,
          "title": "Check Id",
          "type": "string"
        },
        "check_version": {
          "minLength": 1,
          "title": "Check Version",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "expected_constraint": {
          "minLength": 1,
          "title": "Expected Constraint",
          "type": "string"
        },
        "observed_value": {
          "minLength": 1,
          "title": "Observed Value",
          "type": "string"
        },
        "result": {
          "title": "Result",
          "type": "boolean"
        },
        "tool_identity": {
          "minLength": 1,
          "title": "Tool Identity",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "check_version",
        "result",
        "artifact_refs",
        "evidence_ref",
        "tool_identity",
        "observed_value",
        "expected_constraint"
      ],
      "title": "ArtifactAttestation",
      "type": "object"
    },
    "ArtifactDescriptor": {
      "additionalProperties": false,
      "properties": {
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "byte_length": {
          "exclusiveMinimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "role",
        "media_type",
        "byte_length",
        "digest",
        "storage_ref"
      ],
      "title": "ArtifactDescriptor",
      "type": "object"
    },
    "ArtifactDigestProof": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "pattern": "^sha256$",
          "title": "Algorithm",
          "type": "string"
        },
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "byte_length": {
          "exclusiveMinimum": 0,
          "title": "Byte Length",
          "type": "integer"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence_ref": {
          "minLength": 1,
          "title": "Evidence Ref",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "storage_ref": {
          "minLength": 1,
          "title": "Storage Ref",
          "type": "string"
        },
        "tool_identity": {
          "minLength": 1,
          "title": "Tool Identity",
          "type": "string"
        },
        "tool_version": {
          "minLength": 1,
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "artifact_ref",
        "algorithm",
        "digest",
        "byte_length",
        "storage_ref",
        "retrieved_at",
        "evidence_ref",
        "tool_identity",
        "tool_version"
      ],
      "title": "ArtifactDigestProof",
      "type": "object"
    },
    "JsonValue": {}
