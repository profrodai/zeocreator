{
  "$defs": {
    "AudienceIntent": {
      "additionalProperties": false,
      "properties": {
        "consent_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "cross_publication_use_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "frequency_cap_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "jurisdiction_policies": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "title": "Jurisdiction Policies",
          "type": "array"
        },
        "lifecycle_states": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Lifecycle States",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "purpose_of_contact": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Purpose Of Contact",
          "type": "string"
        },
        "required_exclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Exclusions",
          "type": "array"
        },
        "required_inclusions": {
          "default": [],
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "title": "Required Inclusions",
          "type": "array"
        },
        "segment_refs": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Segment Refs",
          "type": "array"
        },
        "suppression_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "segment_refs",
        "consent_policy",
        "suppression_policy",
        "frequency_cap_policy",
        "purpose_of_contact",
        "cross_publication_use_policy"
      ],
      "title": "AudienceIntent",
      "type": "object"
    },
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailCTA": {
      "additionalProperties": false,
      "properties": {
        "cta_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Cta Id",
          "type": "string"
        },
        "desired_action": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Desired Action",
          "type": "string"
        },
        "label": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "link_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Link Id",
          "type": "string"
        },
        "primary": {
          "default": false,
          "title": "Primary",
          "type": "boolean"
        }
      },
      "required": [
        "cta_id",
        "link_id",
        "label",
        "desired_action"
      ],
      "title": "EmailCTA",
      "type": "object"
    },
    "EmailCampaignPlan": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "assumptions": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "attribution_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "audience": {
          "$ref": "#/$defs/AudienceIntent"
        },
        "business_objective": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Business Objective",
          "type": "string"
        },
        "calls_to_action": {
          "items": {
            "$ref": "#/$defs/EmailCTA"
          },
          "minItems": 1,
          "title": "Calls To Action",
          "type": "array"
        },
        "campaign_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "conversion_objectives": {
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "minItems": 1,
          "title": "Conversion Objectives",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "message_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "title": "Message Refs",
          "type": "array"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "publication_profile": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "required_human_approvals": {
          "items": {
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Required Human Approvals",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risks": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Risks",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailArtifactRef"
          },
          "title": "Sequence Refs",
          "type": "array"
        },
        "stopping_conditions": {
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Stopping Conditions",
          "type": "array"
        },
        "tracking_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "publication_profile",
        "business_objective",
        "audience",
        "campaign_window",
        "calls_to_action",
        "conversion_objectives",
        "attribution_policy",
        "tracking_policy",
        "required_human_approvals",
        "stopping_conditions",
        "generation"
      ],
      "title": "EmailCampaignPlan",
      "type": "object"
    },
    "EmailMetricObservation": {
      "additionalProperties": false,
      "properties": {
        "aggregate_segment_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Aggregate Segment Ref",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "attribution_assumptions": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Attribution Assumptions",
          "type": "array"
        },
        "attribution_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "campaign": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_gaps": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "metric": {
          "enum": [
            "attempted",
            "accepted",
            "delivered",
            "deferred",
            "bounced",
            "complained",
            "unsubscribed",
            "opened",
            "unique_link_clicks",
            "cta_conversions",
            "sequence_enrolments",
            "step_completion",
            "step_exit",
            "campaign_conversion",
            "attributed_revenue"
          ],
          "title": "Metric",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "observation_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "operation": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_definition": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Provider Definition",
          "type": "string"
        },
        "provider_definition_version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Definition Version",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "reliability": {
          "enum": [
            "qualified",
            "unreliable",
            "unknown"
          ],
          "title": "Reliability",
          "type": "string"
        },
        "reliability_notes": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reliability Notes",
          "type": "array"
        },
        "retrieval_receipt": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "campaign",
        "operation",
        "retrieval_receipt",
        "provider_kind",
        "connection_ref",
        "aggregate_segment_ref",
        "observation_window",
        "metric",
        "value",
        "unit",
        "provider_definition",
        "provider_definition_version",
        "completeness",
        "coverage",
        "reliability"
      ],
      "title": "EmailMetricObservation",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "campaign": {
      "$ref": "#/$defs/EmailCampaignPlan"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expected_metrics": {
      "items": {
        "enum": [
          "attempted",
          "accepted",
          "delivered",
          "deferred",
          "bounced",
          "complained",
          "unsubscribed",
          "opened",
          "unique_link_clicks",
          "cta_conversions",
          "sequence_enrolments",
          "step_completion",
          "step_exit",
          "campaign_conversion",
          "attributed_revenue"
        ],
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Metrics",
      "type": "array"
    },
    "observation_window": {
      "$ref": "#/$defs/ResearchWindow"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/EmailMetricObservation"
      },
      "title": "Observations",
      "type": "array"
    }
  },
  "required": [
    "campaign",
    "observations",
    "observation_window",
    "expected_metrics",
    "created_at"
  ],
  "title": "AssessEmailProgramRequest",
  "type": "object"
}
