{
  "$defs": {
    "EmailArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Ref",
          "type": "string"
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "ref",
        "revision",
        "digest"
      ],
      "title": "EmailArtifactRef",
      "type": "object"
    },
    "EmailMetricObservation": {
      "additionalProperties": false,
      "properties": {
        "aggregate_segment_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Aggregate Segment Ref",
          "type": "string"
        },
        "artifact_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "attribution_assumptions": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Attribution Assumptions",
          "type": "array"
        },
        "attribution_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "campaign": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "completeness": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ],
          "title": "Completeness",
          "type": "string"
        },
        "connection_ref": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Connection Ref",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "coverage": {
          "maximum": 1,
          "minimum": 0,
          "title": "Coverage",
          "type": "number"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_gaps": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "denominator": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "metric": {
          "enum": [
            "attempted",
            "accepted",
            "delivered",
            "deferred",
            "bounced",
            "complained",
            "unsubscribed",
            "opened",
            "unique_link_clicks",
            "cta_conversions",
            "sequence_enrolments",
            "step_completion",
            "step_exit",
            "campaign_conversion",
            "attributed_revenue"
          ],
          "title": "Metric",
          "type": "string"
        },
        "numerator": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Numerator"
        },
        "observation_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "operation": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "provider_definition": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Provider Definition",
          "type": "string"
        },
        "provider_definition_version": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Definition Version",
          "type": "string"
        },
        "provider_kind": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "reliability": {
          "enum": [
            "qualified",
            "unreliable",
            "unknown"
          ],
          "title": "Reliability",
          "type": "string"
        },
        "reliability_notes": {
          "default": [],
          "items": {
            "maxLength": 20000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reliability Notes",
          "type": "array"
        },
        "retrieval_receipt": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "artifact_id",
        "campaign",
        "operation",
        "retrieval_receipt",
        "provider_kind",
        "connection_ref",
        "aggregate_segment_ref",
        "observation_window",
        "metric",
        "value",
        "unit",
        "provider_definition",
        "provider_definition_version",
        "completeness",
        "coverage",
        "reliability"
      ],
      "title": "EmailMetricObservation",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "artifact_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Artifact Id",
      "type": "string"
    },
    "campaign": {
      "$ref": "#/$defs/EmailArtifactRef"
    },
    "completeness": {
      "enum": [
        "complete",
        "partial",
        "unknown"
      ],
      "title": "Completeness",
      "type": "string"
    },
    "conclusions": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Conclusions",
      "type": "array"
    },
    "confidence": {
      "enum": [
        "limited",
        "qualified"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data_gaps": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Data Gaps",
      "type": "array"
    },
    "generation": {
      "$ref": "#/$defs/GenerationTrace"
    },
    "hypotheses": {
      "items": {
        "maxLength": 20000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "observation_window": {
      "$ref": "#/$defs/ResearchWindow"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/EmailMetricObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "organization_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Organization Id",
      "type": "string"
    },
    "publication_id": {
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
      "title": "Publication Id",
      "type": "string"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "artifact_id",
    "campaign",
    "observation_window",
    "observations",
    "completeness",
    "confidence",
    "conclusions",
    "data_gaps",
    "hypotheses",
    "generation"
  ],
  "title": "EmailProgramAssessment",
  "type": "object"
}
