{
  "$defs": {
    "EditorialReview": {
      "additionalProperties": false,
      "properties": {
        "advisory_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Advisory Findings",
          "type": "array"
        },
        "approval_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Approval Digest",
          "type": "string"
        },
        "article_draft_ref": {
          "minLength": 1,
          "title": "Article Draft Ref",
          "type": "string"
        },
        "attribution_satisfied": {
          "title": "Attribution Satisfied",
          "type": "boolean"
        },
        "blocking_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Blocking Findings",
          "type": "array"
        },
        "claim_traceability": {
          "title": "Claim Traceability",
          "type": "boolean"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "privacy_satisfied": {
          "title": "Privacy Satisfied",
          "type": "boolean"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "qualified_human_required": {
          "title": "Qualified Human Required",
          "type": "boolean"
        },
        "qualified_human_review_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualified Human Review Ref"
        },
        "ready_for_approval": {
          "title": "Ready For Approval",
          "type": "boolean"
        },
        "review_id": {
          "minLength": 1,
          "title": "Review Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "risk_policy_satisfied": {
          "title": "Risk Policy Satisfied",
          "type": "boolean"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "review_id",
        "article_draft_ref",
        "claim_traceability",
        "attribution_satisfied",
        "privacy_satisfied",
        "risk_policy_satisfied",
        "qualified_human_required",
        "ready_for_approval",
        "approval_digest",
        "generation"
      ],
      "title": "EditorialReview",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "review": {
      "$ref": "#/$defs/EditorialReview"
    }
  },
  "required": [
    "review"
  ],
  "title": "ReviewNewsArticleResponse",
  "type": "object"
}
