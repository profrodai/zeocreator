  "additionalProperties": false,
  "properties": {
    "signals": {
      "items": {
        "$ref": "#/$defs/EditorialSignal"
      },
      "title": "Signals",
      "type": "array"
    }
  },
  "required": [
    "signals"
  ],
  "title": "ExtractEditorialSignalsResponse",
  "type": "object"
}
