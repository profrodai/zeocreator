{
  "$defs": {
    "DailyPerformanceAssessment": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "confidence": {
          "minLength": 1,
          "title": "Confidence",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "data_gaps": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Data Gaps",
          "type": "array"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/MetricObservation"
          },
          "title": "Metrics",
          "type": "array"
        },
        "observation_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "performance_relative_to_objective": {
          "minLength": 1,
          "title": "Performance Relative To Objective",
          "type": "string"
        },
        "proposed_follow_up_work": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Proposed Follow Up Work",
          "type": "array"
        },
        "provider_account_provenance": {
          "items": {
            "type": "string"
          },
          "title": "Provider Account Provenance",
          "type": "array"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "publication_operation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Publication Operation Refs",
          "type": "array"
        },
        "reusable_learnings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reusable Learnings",
          "type": "array"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "assessment_id",
        "observation_window",
        "metrics",
        "provider_account_provenance",
        "artifact_refs",
        "publication_operation_refs",
        "performance_relative_to_objective",
        "confidence"
      ],
      "title": "DailyPerformanceAssessment",
      "type": "object"
    },
    "MetricAggregation": {
      "enum": [
        "count",
        "sum",
        "average",
        "rate",
        "unique"
      ],
      "title": "MetricAggregation",
      "type": "string"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "aggregation": {
          "$ref": "#/$defs/MetricAggregation"
        },
        "artifact_ref": {
          "minLength": 1,
          "title": "Artifact Ref",
          "type": "string"
        },
        "attribution_window": {
          "$ref": "#/$defs/ResearchWindow"
        },
        "baseline": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline"
        },
        "connection_ref": {
          "minLength": 1,
          "title": "Connection Ref",
          "type": "string"
        },
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "denominator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Denominator"
        },
        "destination_account_ref": {
          "minLength": 1,
          "title": "Destination Account Ref",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "metric_name": {
          "minLength": 1,
          "title": "Metric Name",
          "type": "string"
        },
        "metric_value": {
          "title": "Metric Value",
          "type": "number"
        },
        "normalized_rate": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Rate"
        },
        "objective_mapping": {
          "minLength": 1,
          "title": "Objective Mapping",
          "type": "string"
        },
        "observation_id": {
          "minLength": 1,
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "provider_definition": {
          "minLength": 1,
          "title": "Provider Definition",
          "type": "string"
        },
        "provider_definition_version": {
          "minLength": 1,
          "title": "Provider Definition Version",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Provider Kind",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "publication_operation_ref": {
          "minLength": 1,
          "title": "Publication Operation Ref",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "observation_id",
        "provider_kind",
        "connection_ref",
        "destination_account_ref",
        "observed_at",
        "artifact_ref",
        "publication_operation_ref",
        "metric_name",
        "metric_value",
        "unit",
        "aggregation",
        "attribution_window",
        "objective_mapping",
        "provider_definition",
        "provider_definition_version"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "ResearchWindow": {
      "additionalProperties": false,
      "properties": {
        "ends_at": {
          "format": "date-time",
          "title": "Ends At",
          "type": "string"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        }
      },
      "required": [
        "starts_at",
        "ends_at"
      ],
      "title": "ResearchWindow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "assessment": {
      "$ref": "#/$defs/DailyPerformanceAssessment"
    }
  },
  "required": [
    "assessment"
  ],
  "title": "AssessPerformanceResponse",
  "type": "object"
}
