        },
        "campaign_release": {
          "$ref": "#/$defs/EmailArtifactRef"
        },
        "draft": {
          "$ref": "#/$defs/EmailMessageDraft"
        },
        "execution": {
          "$ref": "#/$defs/EmailExecutionContext"
        },
        "html_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Html Digest",
          "type": "string"
        },
        "link_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Link Manifest Digest",
          "type": "string"
        },
        "organization_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Organization Id",
          "type": "string"
        },
        "plain_text_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Plain Text Digest",
          "type": "string"
        },
        "proofs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EmailProofReceipt"
          },
          "title": "Proofs",
          "type": "array"
        },
        "publication_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.:/-]{0,199}$",
          "title": "Publication Id",
          "type": "string"
        },
        "review": {
          "$ref": "#/$defs/EmailEditorialReview"
        },
        "schedule_intent": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Schedule Intent"
        },
        "sequence_revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/EmailArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "template_mapping_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Template Mapping Digest",
          "type": "string"
        },
        "tracking_policy": {
          "$ref": "#/$defs/EmailArtifactRef"
        }
      },
      "required": [
        "organization_id",
        "publication_id",
        "campaign_release",
        "execution",
        "template_mapping_digest",
        "draft",
        "html_digest",
        "plain_text_digest",
        "link_manifest_digest",
        "audience_snapshot",
        "tracking_policy",
        "campaign",
        "review"
      ],
