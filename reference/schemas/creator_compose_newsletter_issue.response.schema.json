{
  "$defs": {
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    },
    "GenerationTrace": {
      "additionalProperties": false,
      "properties": {
        "evaluator_findings": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Evaluator Findings",
          "type": "array"
        },
        "generation_attempt": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempt",
          "type": "integer"
        },
        "input_digests": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Input Digests",
          "type": "array"
        },
        "model_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Ref"
        },
        "policy_version": {
          "minLength": 1,
          "title": "Policy Version",
          "type": "string"
        },
        "strategy_ref": {
          "minLength": 1,
          "title": "Strategy Ref",
          "type": "string"
        },
        "strategy_version": {
          "minLength": 1,
          "title": "Strategy Version",
          "type": "string"
        }
      },
      "required": [
        "strategy_ref",
        "strategy_version",
        "policy_version",
        "input_digests"
      ],
      "title": "GenerationTrace",
      "type": "object"
    },
    "NewsletterIssueDraft": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "default": "",
          "title": "Content Digest",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "generation": {
          "$ref": "#/$defs/GenerationTrace"
        },
        "html_content": {
          "$ref": "#/$defs/ContentDocument"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Refs",
          "type": "array"
        },
        "issue_draft_id": {
          "minLength": 1,
          "title": "Issue Draft Id",
          "type": "string"
        },
        "issue_plan_ref": {
          "minLength": 1,
          "title": "Issue Plan Ref",
          "type": "string"
        },
        "organization_id": {
          "minLength": 1,
          "title": "Organization Id",
          "type": "string"
        },
        "plain_text_content": {
          "$ref": "#/$defs/ContentDocument"
        },
        "preheader": {
          "minLength": 1,
          "title": "Preheader",
          "type": "string"
        },
        "publication_id": {
          "minLength": 1,
          "title": "Publication Id",
          "type": "string"
        },
        "revision": {
          "default": 1,
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Refs",
          "type": "array"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "created_at",
        "organization_id",
        "publication_id",
        "issue_draft_id",
        "issue_plan_ref",
        "subject",
        "preheader",
        "html_content",
        "plain_text_content",
        "source_refs",
        "generation"
      ],
      "title": "NewsletterIssueDraft",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "draft": {
      "$ref": "#/$defs/NewsletterIssueDraft"
    }
  },
  "required": [
    "draft"
  ],
  "title": "ComposeNewsletterIssueResponse",
  "type": "object"
}
