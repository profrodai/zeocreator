{
  "$defs": {
    "ReconciliationState": {
      "enum": [
        "pending",
        "confirmed",
        "needs_review"
      ],
      "title": "ReconciliationState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "connection_ref": {
      "minLength": 1,
      "title": "Connection Ref",
      "type": "string"
    },
    "content_digest": {
      "default": "",
      "title": "Content Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "executed_at": {
      "format": "date-time",
      "title": "Executed At",
      "type": "string"
    },
    "input_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "organization_id": {
      "minLength": 1,
      "title": "Organization Id",
      "type": "string"
    },
    "outcome": {
      "minLength": 1,
      "title": "Outcome",
      "type": "string"
    },
    "provider_kind": {
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "title": "Provider Kind",
      "type": "string"
    },
    "provider_operation_ref": {
      "minLength": 1,
      "title": "Provider Operation Ref",
      "type": "string"
    },
    "publication_id": {
      "minLength": 1,
      "title": "Publication Id",
      "type": "string"
    },
    "receipt_id": {
      "minLength": 1,
      "title": "Receipt Id",
      "type": "string"
    },
    "reconciliation_state": {
      "$ref": "#/$defs/ReconciliationState"
    },
    "revision": {
      "default": 1,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "created_at",
    "organization_id",
    "publication_id",
    "receipt_id",
    "operation_id",
    "provider_kind",
    "connection_ref",
    "provider_operation_ref",
    "executed_at",
    "outcome",
    "reconciliation_state"
  ],
  "title": "PublicationReceipt",
  "type": "object"
}
