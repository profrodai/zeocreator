{
  "$defs": {
    "ChannelDestination": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "minLength": 1,
          "title": "Channel",
          "type": "string"
        },
        "connection_ref": {
          "minLength": 1,
          "title": "Connection Ref",
          "type": "string"
        },
        "destination_account_ref": {
          "minLength": 1,
          "title": "Destination Account Ref",
          "type": "string"
        },
        "provider_kind": {
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
          "title": "Provider Kind",
          "type": "string"
        },
        "scheduled_for": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scheduled For"
        }
      },
      "required": [
        "channel",
        "provider_kind",
        "connection_ref",
        "destination_account_ref"
      ],
      "title": "ChannelDestination",
      "type": "object"
    },
    "ContentDocument": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "media_type",
        "content"
      ],
      "title": "ContentDocument",
      "type": "object"
    },
    "ExtensionPayload": {
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "minLength": 1,
          "title": "Namespace",
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/JsonValue"
        },
        "schema_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Schema Digest",
          "type": "string"
        },
        "schema_id": {
          "minLength": 1,
          "title": "Schema Id",
          "type": "string"
        },
        "schema_version": {
          "minLength": 1,
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "namespace",
        "schema_id",
        "schema_version",
        "schema_digest",
        "payload"
      ],
      "title": "ExtensionPayload",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "accessibility_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessibility Text"
    },
    "content": {
      "$ref": "#/$defs/ContentDocument"
    },
    "destination": {
      "$ref": "#/$defs/ChannelDestination"
    },
    "extension": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExtensionPayload"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "selected_artifact_refs": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Selected Artifact Refs",
      "type": "array"
    }
  },
  "required": [
    "destination",
    "selected_artifact_refs",
    "content"
  ],
  "title": "DistributionVariant",
  "type": "object"
}
